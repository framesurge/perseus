# Perseus Membership System Configuration
# Copy this file to .env and modify as needed

# Database Configuration (PostgreSQL)
PG__HOST=127.0.0.1
PG__PORT=5432
PG__USER=postgres
PG__PASSWORD=chou1979
PG__DBNAME=members
PG__POOL__MAX_SIZE=10

# Server Configuration
SRV_CNF__HOST=127.0.0.1
SRV_CNF__PORT=8080
SRV_CNF__SECRET_KEY=2454fae30614fc1e5df49bd910418173e2b634daeed645c6ca1405f4fcff18b9
SRV_CNF__BCRYPT_OR_ARGON=false
SRV_CNF__EMAIL_OTP_ENABLED=true
SRV_CNF__USER_TABLE_NAME=users
SRV_CNF__USER_INVALID_ID=-1000
SRV_CNF__MAX_OTP_ATTEMPTS=10

# SMTP Configuration (Mailpit for local development)
# Mailpit runs on port 1025 for SMTP and 8025 for web UI
# Install: https://github.com/axllent/mailpit
SRV_CNF__SMTP_HOST=127.0.0.1
SRV_CNF__SMTP_PORT=1025
SRV_CNF__SMTP_USERNAME=
SRV_CNF__SMTP_PASSWORD=
SRV_CNF__SMTP_TLS_OFF=true
SRV_CNF__SMTP_FROM_EMAIL=noreply@localhost

# Logging
RUST_LOG=info
